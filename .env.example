# Required: your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: only needed if you exceed GoPlus's free 30 calls/minute limit
GOPLUS_ACCESS_TOKEN=

# Optional: log the raw GoPlus request/response to the server console (off by
# default — leave unset in production, since it prints checked wallet data)
GOPLUS_DEBUG_LOG=false

# Optional x402 paywall config. Set X402_PAY_TO to enable payment protection
# for the explanation APIs. Example payTo address: 0x...
X402_PAY_TO=0x6B0F4651eD42893ab58139938175E4a69f175F25
X402_NETWORK=base-sepolia
X402_CHECK_PRICE=$0.10
X402_EXPLAIN_PRICE=$0.05
X402_FACILITATOR_URL=https://x402.org/facilitator

PORT=3000
